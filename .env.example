# Google AI Studio API key. Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional — override the source repo / branch being ingested
SOURCE_REPO=hashemkhodor/collegesaurus
SOURCE_BRANCH=main

# Optional — Supabase chat-log store. If unset, chat still works but no
# rows are written. Get both from Project Settings → API.
SUPABASE_URL=
SUPABASE_KEY=

# --- FastAPI chatbot (chatbot/, see chatbot/README.md) ------------------------
# GEMINI_API_KEY above is shared. SUPABASE_URL above too; the new service uses a
# secret key (sb_secret_...) instead of the legacy SUPABASE_KEY.
SUPABASE_SECRET_KEY=
# Any long random string; client IPs are stored only as an HMAC with this key.
IP_HASH_SECRET=
# Site that publishes /chatbot/corpus.json (http://localhost:3000 for a local
# `npm run serve` of the collegesaurus site).
SITE_URL=https://collegesaurus.org
# Optional
DAILY_TURN_LIMIT=1500
FRAME_ANCESTORS=https://collegesaurus.org http://localhost:3000
